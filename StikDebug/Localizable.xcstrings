          }
        }
      }
    },
    "1. 打开 设置 → 隐私与安全 → 开发者模式": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 打开 设置 → 隐私与安全 → 开发者模式"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 開啟 設定 → 隱私權與安全性 → 開發者模式"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Open Settings → Privacy & Security → Developer Mode"
          }
        }
      }
    },
    "2. 关闭开发者模式（会提示重启）": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 关闭开发者模式（会提示重启）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 關閉開發者模式（會提示重新啟動）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Turn Developer Mode off (it will ask to restart)"
          }
        }
      }
    },
    "3. 重启后重新打开开发者模式": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 重启后重新打开开发者模式"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 重新啟動後再次開啟開發者模式"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Turn Developer Mode back on after the restart"
          }
        }
      }
    },
    "3–4 万 偏多": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3–4 万 偏多"
