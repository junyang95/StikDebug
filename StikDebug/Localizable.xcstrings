        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikmin Helper 僅供內部學習使用。模擬定位可能違反遊戲服務條款。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikmin Helper is for internal study use only. Simulating location may violate the game's terms of service."
          }
        }
      }
