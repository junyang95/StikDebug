          "stringUnit": {
            "state": "translated",
            "value": "30–40k elevated"
          }
        }
      }
    },
    "4. 回到本 App 点下方「重新检查」": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "4. 回到本 App 点下方「重新检查」"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "4. 回到本 App 點下方「重新檢查」"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Come back and tap “Check again” below"
          }
        }
      }
    },
    "4–5 万 接近上限": {
