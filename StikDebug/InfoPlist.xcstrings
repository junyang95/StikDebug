{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikmin Helper 读取步数，用于展示每日进度和会话统计。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikmin Helper 讀取步數，用於顯示每日進度與工作階段統計。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikmin Helper reads your step count to show daily progress and session stats."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikmin Helper 按模拟行走距离写入会话步数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikmin Helper 依模擬行走距離寫入工作階段步數。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikmin Helper writes session steps based on the simulated walking distance."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikmin Helper 需要访问本地网络，以连接 LocalDevVPN 提供的设备隧道。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikmin Helper 需要存取本機網路，以連接 LocalDevVPN 提供的裝置通道。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikmin Helper needs local network access to reach the device tunnel provided by LocalDevVPN."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikmin Helper 使用低精度后台定位维持行走会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikmin Helper 使用低精度背景定位維持行走工作階段。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikmin Helper uses low-accuracy background location to keep walking sessions alive."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikmin Helper 使用定位维持行走会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikmin Helper 使用定位維持行走工作階段。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikmin Helper uses location to keep walking sessions running."
          }
        }
      }
    },
    "NSMotionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikmin Helper 使用运动信息辅助展示行走数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikmin Helper 使用運動資訊輔助顯示行走資料。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikmin Helper uses motion data to help present your walking stats."
          }
        }
      }
    }
  },
  "version": "1.0"
}
